# Copy to .env and change values. Never commit .env.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot@localhost:5432/careerpilot

# Frontend origin(s) allowed by CORS (comma separated) and used in e-mail links
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Cookies: for HTTPS deployments set COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_DAYS=7
TRUST_PROXY=false

# E-mail: "console" prints links in development only; "smtp" sends real mail
EMAIL_MODE=console
EMAIL_FROM=CareerPilot AI <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Uploads (private folder outside the frontend)
UPLOAD_DIR=./private_uploads
MAX_UPLOAD_MB=5
STORE_ORIGINAL_FILES=true

# Local AI (optional). The app works without it using rule-based features.
AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
AI_TIMEOUT_SECONDS=90

RATE_LIMIT_ENABLED=true

# EMAIL_MODE=brevo_api sends mail over HTTPS (works on hosts that block SMTP ports, e.g. Render free)
BREVO_API_KEY=
